# waggle hive bundle — LOCAL DEV defaults (open auth).
# Copy to .env for an open local hive, then:
#   BUZZ_COMPOSE_DEV=true ./run.sh start
#
# Do NOT use this file for a reachable / production relay.
# Production template: .env.example (closed auth, loopback bind).

# Pinned upstream image. Prefer the default digest; override only intentionally.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:6cf2db58ee1607a99bd7651277c62d1cc41e05f96483b37bba9a4ecabf4cf6cb

# Local ports. 3000 often collides with JS dev servers — 3100 is the waggle default.
# Dev may bind all interfaces; prod .env.example stays on 127.0.0.1.
BUZZ_HTTP_HOST=0.0.0.0
BUZZ_HTTP_PORT=3100
RELAY_URL=ws://localhost:3100
BUZZ_MEDIA_BASE_URL=http://localhost:3100/media
BUZZ_MEDIA_SERVER_DOMAIN=localhost
BUZZ_CORS_ORIGINS=http://localhost:3100

# Open local hive (no membership gate). compose.dev.yml also forces these false.
BUZZ_REQUIRE_AUTH_TOKEN=false
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity (64-char hex). Optional while the hive is open.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once (openssl rand -hex 32), keep in .env, back up.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
TYPESENSE_API_KEY=CHANGE_ME_RANDOM_API_KEY
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media

# Dev override ports (compose.dev.yml).
POSTGRES_PORT=5432
REDIS_PORT=6379
TYPESENSE_PORT=8108
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
