# waggle hive bundle — PRODUCTION defaults (Story 1.3 / FR-8).
# Copy to .env and replace every CHANGE_ME value before running.
#
# Closed by default: auth token + relay membership are required.
# For an open local hive, copy .env.dev.example instead, or run with
# BUZZ_COMPOSE_DEV=true (compose.dev.yml overrides auth to open).
#
# The relay image is PULLED from ghcr.io/block/buzz by immutable digest.
# waggle does not build or publish the image (UP-08 withdrawn; AD-17 rescoped).

# Pinned upstream image. Prefer the default digest; override only intentionally.
# Digest resolved from ghcr.io/block/buzz:main on 2026-07-29.
# NOTE: relay image tags (main / sha-* / relay-v*) are independent of desktop
# release tags like v0.4.26 — see BUZZ_VERSION in the repo root.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:6cf2db58ee1607a99bd7651277c62d1cc41e05f96483b37bba9a4ecabf4cf6cb

# Host bind for the published relay port. Default is loopback-only.
# Publishing on 0.0.0.0 without auth is dangerous — do not change this unless
# you intend to expose the relay and have closed-auth + TLS in place.
BUZZ_HTTP_HOST=127.0.0.1
BUZZ_HTTP_PORT=3100
RELAY_URL=ws://localhost:3100
BUZZ_MEDIA_BASE_URL=http://localhost:3100/media
BUZZ_MEDIA_SERVER_DOMAIN=localhost
BUZZ_CORS_ORIGINS=http://localhost:3100

# Closed production hive — do not flip these to false on a reachable relay.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=false
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity (64-char hex). Required when closed-relay mode is on.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once (openssl rand -hex 32), keep in .env, back up.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
TYPESENSE_API_KEY=CHANGE_ME_RANDOM_API_KEY
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media

# Dev overlay ports (compose.dev.yml only — not published by compose.yml alone).
POSTGRES_PORT=5432
REDIS_PORT=6379
TYPESENSE_PORT=8108
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
